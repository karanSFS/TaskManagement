# Copy to .env.local. Never commit .env.local.
#
# Local values come from `npm run db:status` after `npm run db:start`.
# Use the API URL and the anon (publishable) key. Do not put the
# service_role key in any NEXT_PUBLIC_ variable or client code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Invitation mail through Brevo SMTP.
# Login is the Login field under Brevo → Settings → SMTP & API.
# The key is the SMTP key, used as the SMTP password.
# INVITE_FROM_EMAIL must be a sender verified in that Brevo account.
# A saved invitation stays pending when these are missing.


